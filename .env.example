# Server
PORT=3000
# Express "trust proxy" setting: proxy hops in front of the app. 0 disables it.
TRUST_PROXY=1
# Use /data/stockly.db in Docker. The directory is created automatically.
DATABASE_PATH=./data/stockly.db

# Store test harness
STOCK_API_URL=https://harness-production-e601.up.railway.app/api/stock
STOCK_API_KEY=
# Resend-compatible email endpoint (no /emails suffix required)
RESEND_BASE_URL=
RESEND_API_KEY=
# Optional sender; the harness accepts any address it gave you.
EMAIL_FROM=Stockly <alerts@stockly.app>
# Optional storefront URL used by the email CTA when the stock API returns none.
SHOP_URL=

# Security
WEBHOOK_SECRET=
ADMIN_PASSWORD=
