{
  "name": "stockly-back-in-stock",
  "version": "1.0.0",
  "private": true,
  "description": "Back-in-stock alerts: embeddable widget, verified stock webhooks and exactly-once email delivery.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:local": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=15000 --test-force-exit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
